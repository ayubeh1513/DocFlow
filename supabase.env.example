# =========================================================
# DOCFLOW PROJECT ENVIRONMENT VARIABLES (supabase.env.example)
# 
# This file serves as a template. To run the app, copy this
# content to a new file named supabase.env and replace the 
# placeholders with your actual Supabase credentials.
# =========================================================

# --- 1. SUPABASE CONFIGURATION (Required for Initialization) ---

# SUPABASE_URL: 
# The unique URL for your Supabase project (Project API Key URL).
SUPABASE_URL=YOUR_SUPABASE_PROJECT_URL_HERE

# SUPABASE_KEY: 
# The 'anon' (public) key for your Supabase project. 
SUPABASE_KEY=YOUR_SUPABASE_ANON_KEY_HERE
